{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        },
        "File": {
            "Path": "logs/app.log",
            "Append": true,
            "MinLevel": "Information",
            "FileSizeLimitBytes": 10485760,
            "MaxRollingFiles": 5
        }
    },
    "ConnectionStrings": {
        "AmpSettingDatabase": "Data Source=AmpSettings.db"
    }
}
